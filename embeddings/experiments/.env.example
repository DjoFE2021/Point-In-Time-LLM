# Paths for the news-embedding and portfolio experiments. Copy to embeddings/experiments/.env and edit;
# variables already set in the environment take precedence over this file.

# Directory with the Dow Jones Newswire files DJN_YYYY-MM_retmatched.pkl (licensed, not included)
DJN_DATA_DIR=/path/to/djn_retmatched
# PIT-4B checkpoints <YYYY-MM>_step=<N>_checkpoint.pt for the months in 4b/main.py CHECKPOINTS
PIT_4B_CKPT_DIR=/path/to/checkpoints/4B
# Directory holding only the final PIT-4B checkpoint (4b/main.py --last_ckpt, "4B-Full")
PIT_4B_FULL_CKPT_DIR=/path/to/checkpoints/4B-full
# Merged PIT-4B-FT checkpoints <YYYY-MM>_step=<N>_merged.pt from post_training/sft_all.sh (4b-ft/main.py)
PIT_4B_FT_CKPT_DIR=/path/to/model-sft
# Directory holding only the final merged PIT-4B-FT checkpoint (4b-ft/main.py --last_ckpt, "4B-FT-Full")
PIT_4B_FT_FULL_CKPT_DIR=/path/to/checkpoints/4B-FT-full
# Root of all embedding outputs; each job writes EMBEDDINGS_DIR/<model>/embeddings_monthly.pkl
EMBEDDINGS_DIR=/path/to/embeddings
# JKP stock panel pickle (id, date, r_1, size_grp and factor columns), read by run_experiment.py
JKP_PANEL_PATH=/path/to/jkp_panel.pkl
# Optional: Hugging Face cache for the ChronoGPT snapshots (default: the standard cache, honours HF_HOME)
# CHRONOGPT_CACHE_DIR=/path/to/hf_cache

# Note: VENV and MODEL_TYPE used by the SLURM scripts are shell variables, not read from this file.
